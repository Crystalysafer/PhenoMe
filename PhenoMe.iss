; Inno Setup script for the PhenoMe all-in-one installer.
;
; Prerequisites:
;   1. Run build_v2.bat (or PyInstaller with PhenoMe.spec) so that
;      dist\PhenoMe\ exists with all model weights staged under models\.
;   2. Have Inno Setup 6 installed.
;
; Compile:  ISCC.exe PhenoMe.iss
; Output:   dist\PhenoMeInstaller.exe

#define AppVersion "2.0.0"

[Setup]
; Deterministic AppId (uuid5 of "phenome.installer") — keep stable so future
; releases upgrade/uninstall the same product entry.
AppId={{806E7C6A-03FE-5CA5-B80A-F441A70560D1}
AppName=PhenoMe
AppVersion={#AppVersion}
AppVerName=PhenoMe {#AppVersion}
AppPublisher=PhenoMe Project
AppPublisherURL=https://github.com/Crystalysafer/PhenoMe
AppSupportURL=https://github.com/Crystalysafer/PhenoMe/issues
DefaultDirName={autopf}\PhenoMe
DefaultGroupName=PhenoMe
DisableProgramGroupPage=yes
LicenseFile=LICENSE
OutputDir=installer
OutputBaseFilename=PhenoMeInstaller
; The payload is ~9 GB of model weights; lzma2/fast keeps the single-file
; build quick — the weights are already dense binary formats and barely
; compress further anyway.
Compression=lzma2/fast
SolidCompression=no
; Payload exceeds Windows' ~4.2 GB single-setup-exe limit -> one max-size
; slice next to the launcher exe (DiskSliceSize=max needs Inno >= 6.5.2)
DiskSpanning=yes
DiskSliceSize=max
WizardStyle=modern
WizardResizable=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
; Generated by PIL from pheno\icons\icon.png before compiling (see docs).
SetupIconFile=build\icon.ico
UninstallDisplayIcon={app}\PhenoMe.exe

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop icon"; GroupDescription: "Additional icons:"

[Files]
; No model weights in the installer (~4 GB saved) — models.zip on Zenodo
; carries them; the app runs without them and asks for the archive when a
; segmentation action needs one.
Source: "dist\PhenoMe\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\PhenoMe"; Filename: "{app}\PhenoMe.exe"; IconFilename: "{app}\PhenoMe.exe"
Name: "{autodesktop}\PhenoMe"; Filename: "{app}\PhenoMe.exe"; IconFilename: "{app}\PhenoMe.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\PhenoMe.exe"; Description: "Launch PhenoMe"; Flags: nowait postinstall skipifsilent
